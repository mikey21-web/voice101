deploysafe.in {
    tls admin@deploysafe.in

    # Dashboard SPA
    reverse_proxy localhost:3000

    # API backend
    handle_path /api/* {
        reverse_proxy localhost:3001
    }

    # Webhooks backend (preserve /webhooks prefix)
    handle /webhooks/* {
        reverse_proxy localhost:3001
    }

    # n8n subpath
    handle_path /n8n/* {
        reverse_proxy localhost:5678
    }
}

:80 {
    bind 0.0.0.0
    redir https://{host}{uri} permanent
}
