{
    servers {
        protocols h1 h2
    }
}

deploysafe.in {
    tls admin@deploysafe.in
    encode gzip

    reverse_proxy localhost:3000

    handle_path /api/* {
        reverse_proxy localhost:3001
    }

    handle /webhooks/* {
        reverse_proxy localhost:3001
    }

    handle_path /n8n/* {
        reverse_proxy localhost:5678
    }
}

:80 {
    bind 0.0.0.0
    redir https://{host}{uri} permanent
}
