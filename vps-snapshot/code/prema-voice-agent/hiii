                        "text": "// Currency configuration object\nconst CurrencyConfig = {\n    INR: {\n        code: 'INR',\n        symbol: '₹',\n        locale: 'en-IN',\n        name: 'Indian Rupee',\n        majorUnit: 'Rupees',\n        minorUnit: 'Paisa',\n        decimalPlaces: 2,\n        numberingSystem: 'indian'\n    },\n    MUR: {\n        code: 'MUR',\n        symbol: 'Rs',\n        locale: 'en-MU',\n        name: 'Mauritian Rupee',\n        majorUnit: 'Rupees',\n        minorUnit: 'Cents',\n        decimalPlaces: 2,\n        numberingSystem: 'western'\n    }\n};\n\n// Get current currency from global variable or default to INR\nfunction getCurrentCurrency() {\n    return window.APP_CURRENCY || 'INR';\n}\n\n// Get currency configuration\nfunction getCurrencyConfig(currencyCode = null) {\n    const code = currencyCode || getCurrentCurrency();\n    return CurrencyConfig[code] || CurrencyConfig.INR;\n}\n\nclass NumberToIndianWords {\n    static zeroTo99 = [];\n    static place = 'Thousand|Lakh|Crore|Arab|Kharab|Nil'.split('|');\n\n    static {\n        const ones = '|One|Two|Three|Four|Five|Six|Seven|Eight|Nine|Ten|Eleven|Twelve|Thirteen|Fourteen|Fifteen|Sixteen|Seventeen|Eighteen|Nineteen'.split('|');\n        const tens = '||Twenty|Thirty|Forty|Fifty|Sixty|Seventy|Eighty|Ninety'.split('|');\n\n        for (let i = 0; i < 100; i++) {\n            const t = Math.floor(i / 10);\n            const o = i % 10;\n            NumberToIndianWords.zeroTo99.push(t < 2 ? ones[i] : tens[t] + (o ? ' ' + ones[o] : ''));\n        }\n    }\n\n    static convert(x) {\n        let n = x.length;\n        x = n === 0 ? '00' : n === 1 || n % 2 === 0 ? '0' + x : x;\n        n = x.length;\n        let r = NumberToIndianWords.zeroTo99[x.charCodeAt((n -= 2)) * 10 + x.charCodeAt(n + 1) - 528];\n        if (n >= 1) {\n            const v = NumberToIndianWords.zeroTo99[x.charCodeAt((n -= 1)) - 48];\n            if (v) r = v + ' Hundred' + (r ? ' ' + r : '');\n        }\n        for (let i = 0; n > 0; i++) {\n            const v = NumberToIndianWords.zeroTo99[x.charCodeAt((n -= 2)) * 10 + x.charCodeAt(n + 1) - 528];\n            if (v) r = v + ' ' + NumberToIndianWords.place[i] + (r ? ' ' + r : '');\n        }\n        return r;\n    }\n\n    static transform(value, majorUnit = 'Rupees', minorUnit = 'Paisa') {\n        const [rupee, paisa] = value.toString().split('.');\n        return paisa ? `${NumberToIndianWords.convert(rupee)} ${majorUnit} and ${NumberToIndianWords.convert(paisa)} ${minorUnit}` : `${NumberToIndianWords.convert(rupee)} ${majorUnit}`;\n    }\n}\n\nclass NumberToWesternWords {\n    static ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',\n                   'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',\n                   'Seventeen', 'Eighteen', 'Nineteen'];\n    static tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];\n    static thousands = ['', 'Thousand', 'Million', 'Billion', 'Trillion'];\n\n    static convertLessThanThousand(num) {\n        if (num === 0) return '';\n\n        let result = '';\n\n        if (num >= 100) {\n            result += this.ones[Math.floor(num / 100)] + ' Hundred ';\n            num %= 100;\n        }\n\n        if (num >= 20) {\n            result += this.tens[Math.floor(num / 10)] + ' ';\n            num %= 10;\n        }\n\n        if (num > 0) {\n            result += this.ones[num] + ' ';\n        }\n\n        return result.trim();\n    }\n\n    static convert(num) {\n        if (num === 0) return 'Zero';\n\n        let result = '';\n        let thousandCounter = 0;\n\n        while (num > 0) {\n            if (num % 1000 !== 0) {\n                result = this.convertLessThanThousand(num % 1000) +\n                        (this.thousands[thousandCounter] ? ' ' + this.thousands[thousandCounter] : '') +\n                        (result ? ' ' + result : '');\n            }\n            num = Math.floor(num / 1000);\n            thousandCounter++;\n        }\n\n        return result.trim();\n    }\n\n    static transform(value, majorUnit = 'Rupees', minorUnit = 'Cents') {\n        const [major, minor] = value.toString().split('.');\n        const majorNum = parseInt(major) || 0;\n        const minorNum = parseInt(minor) || 0;\n\n        let result = this.convert(majorNum) + ' ' + majorUnit;\n\n        if (minor && minorNum > 0) {\n            result += ' and ' + this.convert(minorNum) + ' ' + minorUnit;\n        }\n\n        return result;\n    }\n}\n\nfunction properCurrency(price, currencyCode = null) {\n    const config = getCurrencyConfig(currencyCode);\n\n    const formatter = new Intl.NumberFormat(config.locale, {\n        style: 'currency',\n        currency: config.code,\n        minimumFractionDigits: config.decimalPlaces\n    });\n\n    if (isNaN(price) || !price.toString().trim()) {\n        return '';\n    }\n\n    const formattedPrice = formatter.format(price);\n\n    // Convert to words based on numbering system\n    let words;\n    if (config.numberingSystem === 'indian') {\n        words = NumberToIndianWords.transform(price, config.majorUnit, config.minorUnit);\n    } else {\n        words = NumberToWesternWords.transform(price, config.majorUnit, config.minorUnit);\n    }\n\n    return `${formattedPrice} ( ${words} )`;\n}\n\ndocument.addEventListener(\"turbo:load\", () => {\n\n    const priceInputs = document.querySelectorAll('.proper-currency');\n\n    priceInputs.forEach(function (input) {\n        const span = document.createElement('span');\n        span.classList.add('price-in-words');\n\n        // Update span content on input change and initial load\n        const updateSpan = function () {\n            const price = input.value;\n            const words = properCurrency(price);\n            span.textContent = words;\n        };\n\n        updateSpan(); // Update initially\n\n        input.addEventListener('input', updateSp