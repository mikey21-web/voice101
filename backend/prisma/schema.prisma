  conversationId String?
  goal           String
  metric         String
  target         Float
  current        Float
  status         String   @default("active") // active | awaiting_approval | completed | failed | cancelled
  steps          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, status])
  @@index([userId])
  @@map("jarvis_outcomes")
}

