// === KYC / DOCUMENTS ===
// Never store raw Aadhaar numbers, document passwords, or bank secrets here —
// only masked identifiers, verification status, consent, and a provider
// response reference (spec 48.10 / 55.4 invariant 7: an unverified document
// is never displayed as verified).

/// A single consented verification event against a BuyerDocument. Holds only
/// the verification outcome and a provider reference — never the underlying
/// XML/ZIP/share code, which per spec 48.10 must be discarded immediately
/// after a short-lived worker validates it.

/// A legal/finance-approved template for a generated document (agreement,
/// demand letter, NOC, ...). Generation always snapshots the template
/// version used so an issued document never silently changes (spec 69.1).

// === COLLECTIONS: RECEIPTS + LEDGER ===

/// A recorded payment against one or more PaymentSchedule milestones. Never
/// mutated after CONFIRMED — a correction creates a REVERSED status plus a
/// new LedgerEntry, preserving a full audit trail (spec 48.11).

/// One payment can allocate across multiple milestones (spec 48.11) — this is
/// the join between a receipt and the PaymentSchedule rows it settles.

/// Append-only buyer ledger (spec 48.11) — current balance is always computed
/// from these rows, never hand-typed. Nothing here is ever updated in place.

// === CHANNEL PARTNER PORTAL ===

/// Separate auth/session scope from the internal User table (spec 48.12) — a
/// partner logging in must never inherit internal tenant-staff permissions.

/// A partner's lead registration attempt. The response to the partner must
/// stay neutral (spec 48.12) — never leak another partner's name — while an
/// internal manager resolves disputes with an immutable decision record.

/// A versioned commission rule. Every accrual snapshots the plan that
/// produced it (spec 48.12 / 70.2) so a later plan change never rewrites
/// history.

// === CROSS-CUTTING: INTEGRATION EVENTS, SLA BREACHES, APPROVAL REQUESTS ===

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@map("integration_event_status")
}

/// First-class idempotency store for external webhooks (spec 46.2 / 49.2): a
/// provider event ID is recorded here before any side effect runs, so a
/// retried webhook can never create a duplicate lead/message/booking/payment.
model IntegrationEvent {
  id          String                 @id @default(uuid())
  tenantId    String?                @map("tenant_id")
  tenant      Tenant?                @relation(fields: [tenantId], references: [id])
  provider    String
  status      IntegrationEventStatus @default(RECEIVED)
  payload     Json                   @default("{}")
  error       String?
  processedAt DateTime?
  createdAt   DateTime               @default(now())

  @@index([tenantId, status])
  @@map("integration_events")
}

/// First-class SLA breach record (spec 46.2 / 6): a scan writes one row per
/// missed target so "8 hot leads are untouched" is a real, queryable, auditable
/// fact instead of a transient in-memory finding.

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("approval_request_status")
}

/// Generic approval object shared by discount/hold-extension/booking-cancel/
/// price-override/payment-waiver flows (spec 46.5) instead of one-off ad hoc
/// approval fields scattered per module.
model ApprovalRequest {
  id             String                @id @default(uuid())
  tenantId       String                @map("tenant_id")
  tenant         Tenant                @relation(fields: [tenantId], references: [id])
  type           String
  entityType     String
  entityId       String
  requestedById  String?
  requestedBy    User?                 @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  status         ApprovalRequestStatus @default(PENDING)
  policySnapshot Json                  @default("{}")
  amountPaise    BigInt?
  reason         String?
  approvedById   String?
  approvedBy     User?                 @relation("ApprovalDecidedBy", fields: [approvedById], references: [id])
  decidedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime              @default(now())

  @@index([tenantId, status])
  @@index([entityType, entityId])
  @@map("approval_requests")
}

/// Configurable approval matrix: which role must decide a given approval `type`
/// once its amount crosses `minAmountPaise`. Matched by highest minAmountPaise
/// <= the request's amount; falls back to MANAGER when no policy matches.
model ApprovalPolicy {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  type           String
  minAmountPaise BigInt?
  requiredRole   UserRole
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, type])
  @@map("approval_policies")
}

// === BUYER PORTAL ===

/// Single-purpose, hashed, short-lived magic link for buyer portal login
/// (spec 54.1). Never store the raw token — only its hash — and a token can
/// only ever be used once.

// === PAYMENT PLAN TEMPLATES ===

/// A reusable milestone breakdown (spec 16/54.5) — `milestones` is an ordered
/// JSON array of `{ label, percentage, dueOffsetDays?, triggerNote? }`.
/// dueOffsetDays anchors a milestone to the booking date (time-linked plans);
/// construction-linked milestones instead carry a triggerNote and get their
/// due date set manually once that construction stage is actually reached —
/// this app has no way to know real-world construction progress on its own.

// === MODULE 4.1: MARKETING JOURNEY BUILDER ===

/// A configurable multi-step drip campaign (nurture sequence) for automating
/// lead follow-up over time. Separate from the simpler Campaign model because
/// this one encodes ordered steps with conditions, version snapshots, and
/// per-lead enrollment progress — a full automation journey, not a one-off send.

/// An ordered step within a MarketingJourney. The step's config JSON holds
/// step-type-specific fields (e.g. waitHours for WAIT, templateId for SEND_TEMPLATE).

/// A lead enrolled in a MarketingJourney. Snapshots the journey version/steps
/// at enrollment time so retroactive changes never alter an enrolled lead's path.

// === MODULE 4.2: EVENTS / LAUNCHES ===

/// A single forecast entry for a project's projected cash position. Entries
/// can be auto-derived (from PaymentSchedule, CommissionAccrual) or manually
/// entered for planned expenses. Label clearly as forecast, not accounting.

// === MODULE 4.5: LANDOWNER / CO-PROMOTER REVENUE-SHARE ALLOCATION ===

/// A landowner or co-promoter entitled to a share of booking revenue from a
/// project. Separate from ChannelPartner commissions since these are ownership
/// entitlements, not referral fees.

/// An allocation of revenue (unit or booking-based) to a RevenueShareParty.
/// At least one of unitId/bookingId must be set.

// === MODULE 4.6: RESALE / RENTAL LISTING INVENTORY ===

/// Secondary-market resale and rental listings handled by the builder/broker.
/// Separate from new-developer Unit inventory (the builder's own project units)
/// and from Property (which is a generic broker listing — this one is explicitly
/// for resale/rental secondary market with its own lifecycle).

// === MODULE 4.7: REFERRAL / LOYALTY PROGRAM ===

/// A referral program configuration that existing buyers can use to refer new
/// leads. Rewards are never auto-paid — approval is always required.

/// An individual referral submitted by an existing buyer (referrer) pointing to
/// a new prospect (referredPhone). Status tracks the referral from submission
/// through reward lifecycle. Self-referral and duplicate-referrer are blocked.

// === MODULE 4.8: NRI / INTERNATIONAL BUYER WORKFLOW ===

/// Overseas buyer profile attached to a Lead. Adds timezone-aware scheduling
/// and document-type hints. One profile per lead (unique constraint on leadId).

// === MODULE 4.9: VENDOR / CONSTRUCTION ERP INTEGRATION (STUB ADAPTER) ===

/// A per-project ERP connection configuration. Status defaults to NOT_CONFIGURED
/// since no real ERP credentials ship with the system.

/// A manually-recorded or ERP-synced construction progress milestone update.
/// This is what feeds the "construction update" feed shown to buyers.

// === MODULE 4.10: SEARCHABLE PERMISSION-AWARE FILE CABINET ===

/// Lightweight read-cache index for cross-source document search. Queries
/// MediaFile, GeneratedDocument, and BuyerDocument at search time and merges
/// results; this index table exists only if live queries prove too slow.
/// Populated by a periodic rebuildIndex method, not by hooks into other
/// modules' services (to avoid editing files outside this module's scope).

// === MODULE 4.11: PHYSICAL DOCUMENT CUSTODY TRACKING ===

/// Tracks physical paper originals (signed agreements, registered documents)
/// kept in a filing cabinet — who checked them out, when they're due back,
/// and whether they've been returned. Independent of digital GeneratedDocument.

/// A tenant-configured overdue-interest rule (spec 67.4) — rate/grace period
/// are the builder's own policy, never hardcoded here. computeOverdueCharge
/// snapshots the policy version used on the resulting LedgerEntry so a later
/// rate change never rewrites an already-charged milestone.

/// An explicit, audited reduction to what a buyer owes — a waiver or a
/// correction — so a discount never just vanishes as an unexplained ledger
/// edit (spec 67.4).

/// Loan and registration coordination (spec 67.2) — this app tracks staff-
/// confirmed status, it never performs bank underwriting or government
/// registration itself.

/// A public browsing session for the buyer-facing digital sales room — not an
/// authenticated staff user (spec 62.4).

/// Buyer's saved units in the digital sales room (spec 62.2 "saved shortlist/cart").

/// A public buyer's short-lived (10-20 min) reservation on a unit during
/// online checkout — separate from the salesperson UnitHold, never manually
/// extended, auto-released unless a verified payment/booking transition lands
/// first (spec 62.3).

/// One buyer's attempt to complete online checkout for one unit — the
/// server-side record of the "checkout wizard" (spec 62.2), independent of
/// PaymentIntent so an abandoned checkout is still visible for follow-up.

/// A token/booking-amount payment attempt through a real payment gateway.
/// Never trust the browser redirect — only a verified signed webhook may move
/// this to CONFIRMED (spec 62.3). `provider` stays null and status stays
/// CREATED forever if no gateway is configured for the tenant; the checkout
/// UI must show "payments not configured" rather than fake success.

/// Immutable behavioural events for the digital sales room funnel report
/// (spec 62.4/66.3) — unit.viewed, unit.shortlisted, checkout.started, etc.

/// A published marketing landing page built from approved components (spec
/// 66.1) — content only, no arbitrary script injection; forms on it create
/// leads through the normal lead-ingestion path.

/// A saved, reusable lead filter used by campaigns/journeys (spec 66.1) — a
/// definition, not a frozen snapshot, so it stays live as leads change.

/// An opt-out record — an opted-out contact never receives a non-essential
/// send on that channel again (spec 51/66.1). Checked before every bulk
/// send, not just campaign sends.

/// An imported ad-spend batch, kept separate from leads so "cost per booking"
/// reports can join spend to leads by project/campaign/date without
/// conflating the two data sources (spec 66.1/25).

/// Tracks per-tenant onboarding-wizard progress with an explicit validator
/// per step, not a vague "setup complete" flag (spec 54.2).
model TenantOnboardingStep {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  stepKey       String
  status        String    @default("NOT_STARTED")
  completedAt   DateTime?
  completedById String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, stepKey])
  @@index([tenantId])
  @@map("tenant_onboarding_steps")
}

/// ===================== Voice Employee engine =====================
/// An AI voice agent as a first-class, versioned object: identity, voice config,
/// and a section graph (conditional LLM nodes) that compiles into a Dograh
/// workflow at publish time. dograhWorkflowId is the execution backend this
/// employee runs on — the graph/versioning/billing model lives here, in our
/// own DB, so it survives regardless of which underlying engine executes calls.
model VoiceEmployee {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  name String
  role String
  mode String @default("instant") // instant | bulk | inbound
  avatarUrl String? @map("avatar_url")

  voiceProvider String  @map("voice_provider")
  voiceId       String  @map("voice_id")
  voiceName     String? @map("voice_name")
  ttsSpeed      Float   @default(1) @map("tts_speed")
  language      String  @default("te-IN")
  extraLanguages Json   @default("[]") @map("extra_languages")
  ambientSound   String? @map("ambient_sound")
  ambientVolume  Float   @default(0) @map("ambient_volume")
  maxCallDurationS Int   @default(600) @map("max_call_duration_s")
  callTimeoutMessage String? @map("call_timeout_message") @db.Text

  status String @default("inactive") // inactive | active | paused

  welcomeMessage      String? @map("welcome_message") @db.Text
  agentInformation     String? @map("agent_information") @db.Text
  callEndRules         String? @map("call_end_rules") @db.Text
  scriptAdherence      Int     @default(2) @map("script_adherence")
  powerPrompting       Boolean @default(false) @map("power_prompting")
  stylePackEnabled     Boolean @default(true) @map("style_pack_enabled")
  aiAcknowledgementEnabled Boolean @default(true) @map("ai_acknowledgement_enabled")
  recordingNotice      Boolean @default(false) @map("recording_notice")

  numberId String? @map("number_id")
  number   VoicePhoneNumber? @relation(fields: [numberId], references: [id])

  dograhWorkflowId String? @map("dograh_workflow_id")
  dograhWorkflowUuid String? @map("dograh_workflow_uuid")

  revision              Int       @default(1)
  isPublished           Boolean   @default(false) @map("is_published")
  hasUnpublishedChanges Boolean   @default(false) @map("has_unpublished_changes")
  publishedAt           DateTime? @map("published_at")

  hiredUntil             DateTime? @map("hired_until")
  hireSubscriptionStatus String?   @map("hire_subscription_status")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime? @map("deleted_at")

  sections   VoiceEmployeeSection[]
  variables  VoiceEmployeeVariable[]
  actions    VoiceEmployeeAction[]
  deliveries VoiceEmployeeDelivery[]
  versions   VoiceEmployeeVersion[]
  leads      VoiceLead[]
  calls      VoiceCall[]
  campaigns  VoiceCampaign[]
  trainingExamples VoiceTrainingExample[]

  @@index([tenantId])
  @@map("voice_employees")
}

/// One node in the call-flow graph: a goal-oriented prompt step with conditional
/// edges to the next section. Compiled into the underlying engine's node graph
/// (e.g. Dograh agentNode) at publish time — this table is the source of truth,
/// the compiled form is a build artifact.
model VoiceEmployeeSection {
  id         String  @id @default(uuid())
  employeeId String  @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  sectionKey String  @map("section_key")
  label      String
  prompt     String  @db.Text
  enabled    Boolean @default(true)
  order      Int
  nodeType   String  @default("llm") @map("node_type")
  edges      Json    @default("[]") // [{ to_key, condition }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, sectionKey])
  @@index([employeeId])
  @@map("voice_employee_sections")
}

/// A value tracked across the call: either injected before dialling (source=pre,
/// e.g. lead_name/phone) or extracted from what the caller says (source=capture,
/// e.g. budget/intent). Drives both prompt templating ({{key}}) and post-call
/// structured outcome data.
model VoiceEmployeeVariable {
  id         String @id @default(uuid())
  employeeId String @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  key         String
  label       String
  source      String  @default("capture") // pre | capture
  required    Boolean @default(false)
  extractHint String? @map("extract_hint")

  createdAt DateTime @default(now())

  @@unique([employeeId, key])
  @@index([employeeId])
  @@map("voice_employee_variables")
}

/// Mid-call tool the agent can invoke (transfer, book_appointment, send_whatsapp,
/// custom_api). gated=true means it needs an integration connected before it can
/// be enabled — mirrors the real-world dependency, not just a UI toggle.
model VoiceEmployeeAction {
  id         String @id @default(uuid())
  employeeId String @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  actionKey  String  @map("action_key")
  label      String
  enabled    Boolean @default(false)
  gated      Boolean @default(false)
  gateReason String? @map("gate_reason")
  config     Json?

  @@unique([employeeId, actionKey])
  @@index([employeeId])
  @@map("voice_employee_actions")
}

/// Where captured call outcomes get pushed after the call ends: WhatsApp, Google
/// Sheets, a generic webhook. Separate from EmployeeAction (mid-call, live tools)
/// — deliveries fire once, at call completion.
model VoiceEmployeeDelivery {
  id         String @id @default(uuid())
  employeeId String @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type    String // whatsapp | sheets | webhook | email
  config  Json
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("voice_employee_deliveries")
}

/// Full snapshot on every publish — enables restore-to-version without
/// depending on the underlying engine's own version history (which may not
/// exist, or may be provider-specific).
model VoiceEmployeeVersion {
  id         String @id @default(uuid())
  employeeId String @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  revision  Int
  snapshot  Json // full employee + sections + variables at publish time
  publishedById String? @map("published_by_id")

  createdAt DateTime @default(now())

  @@unique([employeeId, revision])
  @@index([employeeId])
  @@map("voice_employee_versions")
}

/// DLT-registered (or provider-issued) phone number an employee dials from /
/// receives calls on. kycStatus tracks the real-world compliance step this
/// requires in India — separate from whether the number is technically live.
model VoicePhoneNumber {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  number       String  @unique
  provider     String  @default("twilio")
  dltRegistered Boolean @default(false) @map("dlt_registered")
  kycStatus    String  @default("not_started") @map("kyc_status") // not_started | pending | verified
  status       String  @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees VoiceEmployee[]

  @@index([tenantId])
  @@map("voice_phone_numbers")
}

/// Persistent caller memory: stores extracted facts (name, intent, preferences, etc.)
/// per phone number, retrieved and enriched on each new call from that number.
/// Facts are JSON to allow flexible schema evolution without migrations.
model VoiceCaller {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  phoneNumber  String   @map("phone_number")
  facts        Json     @default("{}") /// { "name": "...", "intent": "...", "budget": "...", etc. }
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, phoneNumber])
  @@index([tenantId])
  @@map("voice_callers")
}

/// A completed (or in-progress) call placed/received by a VoiceEmployee.
/// Deliberately separate from the pre-existing CallLog model: CallLog is the
/// general cross-channel call record used by the human-agent telephony path
/// (TwilioVoiceAdapter); VoiceCall is specific to AI-employee-run calls and
/// carries the richer outcome/quality data this engine produces.
model VoiceCall {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  employeeId String  @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id])
  campaignId String? @map("campaign_id")
  campaign   VoiceCampaign? @relation(fields: [campaignId], references: [id])

  direction String @default("outbound")
  durationS Int?   @map("duration_s")
  costInr   Float  @default(0) @map("cost_inr")
  isWebCall Boolean @default(false) @map("is_web_call")

  fromNumber String? @map("from_number")
  toNumber   String  @map("to_number")

  recordingUrl String? @map("recording_url") @db.Text
  transcript   Json?
  summary      String? @db.Text

  disposition String? // qualified | no_answer | busy | failed | cancelled | blocked_dnc | voicemail
  outcome     Json?   // structured captured variables

  talkRatio      Json? @map("talk_ratio") // { agent: number, caller: number }
  sentiment      String? // positive | neutral | negative
  recommendedNextStep String? @map("recommended_next_step") @db.Text

  qualityScore Int? @map("quality_score") // from call-quality.ts linter, computed at read or backfilled here

  dograhRunId String? @map("dograh_run_id")

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([employeeId])
  @@index([campaignId])
  @@map("voice_calls")
}

/// A lead surfaced through an instant-call webhook or a bulk campaign, with
/// whatever the call captured. Separate from the CRM's own Lead model — this
/// is the voice-engine's own record of "who did an employee call and what
/// happened," which the CRM Lead can optionally be updated from.
model VoiceLead {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  tenant     Tenant  @relation(fields: [tenantId], references: [id])
  employeeId String  @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id])
  callId     String? @map("call_id")

  phone   String
  contact String?
  source  String  @default("manual") // manual | instant_webhook | bulk_campaign | test_call
  outcome String?
  captured Json   @default("{}")
  summary  String? @db.Text

  attempt      Int       @default(1)
  callbackAt   DateTime? @map("callback_at")
  timeToCallS  Int?      @map("time_to_call_s")

  createdAt DateTime @default(now())
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([employeeId])
  @@map("voice_leads")
}

/// Training examples mined from calls: owner-annotated corrections that improve future call quality.
/// These are injected into LLM context ("learn from past mistakes") on subsequent calls.
model VoiceTrainingExample {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  employeeId String   @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id])
  callId     String?  @map("call_id")

  issue      String   @db.Text /// "Agent didn't ask about budget"
  correction String   @db.Text /// "Ask: What's your budget range for this property?"
  context    String?  @db.Text /// optional: call transcript snippet or extra context

  status     String   @default("active") /// active | archived | applied
  appliedAt  DateTime? @map("applied_at") /// when this example was last used in a call

  createdAt DateTime @default(now())
  createdBy  String?  @map("created_by") /// user ID who annotated this

  @@index([tenantId])
  @@index([employeeId])
  @@index([status])
  @@map("voice_training_examples")
}

/// A bulk-calling run against a list of contacts. Named VoiceCampaign (not
/// Campaign) to avoid colliding with the existing generic marketing Campaign
/// model, which this is not — it's calling-specific (retry/schedule/dialler
/// config), one employee, backed by a Dograh campaign underneath.
model VoiceCampaign {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  employeeId String @map("employee_id")
  employee   VoiceEmployee @relation(fields: [employeeId], references: [id])

  name   String
  status String @default("draft") // draft | running | paused | completed

  totalContacts Int @default(0) @map("total_contacts")
  dialed        Int @default(0)
  reached       Int @default(0)

  maxConcurrency Int?  @map("max_concurrency")
  retryConfig    Json? @map("retry_config")
  scheduleConfig Json? @map("schedule_config")

  dograhCampaignId Int? @map("dograh_campaign_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calls VoiceCall[]

  @@index([tenantId])
  @@map("voice_campaigns")
}

enum EscalationTrigger {
  LEAD_REQUESTED_HUMAN
  DEAL_VALUE_OVER_THRESHOLD
  NEGATIVE_SENTIMENT
  LOW_MODEL_CONFIDENCE
  PRICE_NEGOTIATION
  LEGAL_OR_COMMITMENT

  @@map("escalation_trigger")
}

/// Phase 5: Mikey hands a lead to a human and stops acting on it. An unresolved
/// row is the per-lead pause — every autonomous path checks for one before
/// acting. The trigger log is also the training data Phase 7's coach learns
/// from, so rows are kept after resolution rather than deleted.
model LeadEscalation {
  id         String            @id @default(uuid())
  tenantId   String            @map("tenant_id")
  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  leadId     String
  lead       Lead              @relation(fields: [leadId], references: [id])
  trigger    EscalationTrigger
  detail     String
  resolvedAt DateTime?
  resolvedById String?
  createdAt  DateTime          @default(now())

  @@index([tenantId, leadId, resolvedAt])
  @@index([leadId])
  @@map("lead_escalations")
}

/// Phase 7 (Rail D). One coaching record per call, for every call at every
/// stage — not just the negotiation call. The rep sees their own row; only an
/// admin sees them side by side. There is deliberately no public leaderboard:
/// a sales team quietly kills a tool that grades them in front of each other.
model CallCoaching {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  callLogId     String   @unique
  callLog       CallLog  @relation(fields: [callLogId], references: [id], onDelete: Cascade)
  /// The rep being coached. Null for a call Mikey handled on its own.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  leadId        String?

  /// 0-100. Null when the model could not score the call rather than 0, so a
  /// failed analysis never looks like a terrible call.
  score         Int?
  missedQuestions   String[] @default([])
  objections        String[] @default([])
  buyingSignals     String[] @default([])
  recommendedAction String?
  whatToSend        String?
  /// 0-1 chance this deal closes, as read from this call alone.
  dealProbability   Float?
  /// Set when the call is good enough to show a new rep as an example.
  isExemplar    Boolean  @default(false)
  analysisStatus String  @default("PENDING")
  createdAt     DateTime @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, isExemplar])
  @@map("call_coachings")
}
